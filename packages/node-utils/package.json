{
  "name": "@shamt/node-utils",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "author": "i7eo",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./disk": {
      "types": "./src/disk.ts",
      "import": "./src/disk.ts"
    },
    "./execute-command": {
      "types": "./src/execute-command.ts",
      "import": "./src/execute-command.ts"
    },
    "./graceful-exit": {
      "types": "./src/graceful-exit.ts",
      "import": "./src/graceful-exit.ts"
    },
    "./monorepo": {
      "types": "./src/monorepo.ts",
      "import": "./src/monorepo.ts"
    },
    "./net": {
      "types": "./src/net.ts",
      "import": "./src/net.ts"
    },
    "./unified-spawn": {
      "types": "./src/unified-spawn.ts",
      "import": "./src/unified-spawn.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/esm/index.d.mts",
        "import": "./dist/esm/index.mjs",
        "require": "./dist/cjs/index.cjs"
      },
      "./disk": {
        "types": "./dist/esm/disk.d.mts",
        "import": "./dist/esm/disk.mjs",
        "require": "./dist/cjs/disk.cjs"
      },
      "./execute-command": {
        "types": "./dist/esm/execute-command.d.mts",
        "import": "./dist/esm/execute-command.mjs",
        "require": "./dist/cjs/execute-command.cjs"
      },
      "./graceful-exit": {
        "types": "./dist/esm/graceful-exit.d.mts",
        "import": "./dist/esm/graceful-exit.mjs",
        "require": "./dist/cjs/graceful-exit.cjs"
      },
      "./monorepo": {
        "types": "./dist/esm/monorepo.d.mts",
        "import": "./dist/esm/monorepo.mjs",
        "require": "./dist/cjs/monorepo.cjs"
      },
      "./net": {
        "types": "./dist/esm/net.d.mts",
        "import": "./dist/esm/net.mjs",
        "require": "./dist/cjs/net.cjs"
      },
      "./unified-spawn": {
        "types": "./dist/esm/unified-spawn.d.mts",
        "import": "./dist/esm/unified-spawn.mjs",
        "require": "./dist/cjs/unified-spawn.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "pnpm clean:cache && node --env-file=../../.env.development ./node_modules/rolldown/bin/cli.mjs --config ./build.config.ts",
    "build": "pnpm clean:cache && node --env-file=../../.env.production ./node_modules/rolldown/bin/cli.mjs --config ./build.config.ts",
    "test": "vitest run",
    "format": "prettier \"./**/*.{js,ts,jsx,tsx,md,json,jsonc}\" --write",
    "lint": "TIMING=1 eslint \"./**/*.{js,jsx,ts,tsx,md,json,jsonc}\" --fix",
    "clean": "run-p \"clean:**\"",
    "clean:cache": "rimraf dist",
    "clean:deps": "rimraf node_modules"
  },
  "dependencies": {
    "@manypkg/get-packages": "catalog:dx"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@unconfig/ts-config-latest": "catalog:dx",
    "rolldown": "catalog:dx",
    "rolldown-plugin-dts": "catalog:dx",
    "typescript": "catalog:",
    "vitest": "catalog:test"
  }
}
