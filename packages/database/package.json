{
  "name": "@shamt/database",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "author": "i7eo",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "import": "./src/constants/index.ts",
      "require": "./src/constants/index.ts"
    },
    "./models": {
      "types": "./src/models/index.ts",
      "import": "./src/models/index.ts",
      "require": "./src/models/index.ts"
    },
    "./models/postgres": {
      "types": "./src/models/postgres/index.ts",
      "import": "./src/models/postgres/index.ts",
      "require": "./src/models/postgres/index.ts"
    },
    "./models/postgres/*": {
      "types": "./src/models/postgres/*.ts",
      "import": "./src/models/postgres/*.ts",
      "require": "./src/models/postgres/*.ts"
    },
    "./models/sqlite": {
      "types": "./src/models/sqlite/index.ts",
      "import": "./src/models/sqlite/index.ts",
      "require": "./src/models/sqlite/index.ts"
    },
    "./models/sqlite/*": {
      "types": "./src/models/sqlite/*.ts",
      "import": "./src/models/sqlite/*.ts",
      "require": "./src/models/sqlite/*.ts"
    },
    "./sql-schemas": {
      "types": "./src/sql-schemas/index.ts",
      "import": "./src/sql-schemas/index.ts",
      "require": "./src/sql-schemas/index.ts"
    },
    "./sql-schemas/postgres": {
      "types": "./src/sql-schemas/postgres/index.ts",
      "import": "./src/sql-schemas/postgres/index.ts",
      "require": "./src/sql-schemas/postgres/index.ts"
    },
    "./sql-schemas/postgres/*": {
      "types": "./src/sql-schemas/postgres/*.ts",
      "import": "./src/sql-schemas/postgres/*.ts",
      "require": "./src/sql-schemas/postgres/*.ts"
    },
    "./sql-schemas/sqlite": {
      "types": "./src/sql-schemas/sqlite/index.ts",
      "import": "./src/sql-schemas/sqlite/index.ts",
      "require": "./src/sql-schemas/sqlite/index.ts"
    },
    "./sql-schemas/sqlite/*": {
      "types": "./src/sql-schemas/sqlite/*.ts",
      "import": "./src/sql-schemas/sqlite/*.ts",
      "require": "./src/sql-schemas/sqlite/*.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./constants": {
        "types": "./dist/constants/index.d.mts",
        "import": "./dist/constants/index.mjs",
        "require": "./dist/constants/index.cjs"
      },
      "./models": {
        "types": "./dist/models/index.d.mts",
        "import": "./dist/models/index.mjs",
        "require": "./dist/models/index.cjs"
      },
      "./models/postgres": {
        "types": "./dist/models/postgres/index.d.mts",
        "import": "./dist/models/postgres/index.mjs",
        "require": "./dist/models/postgres/index.cjs"
      },
      "./models/postgres/*": {
        "types": "./dist/models/postgres/*.d.mts",
        "import": "./dist/models/postgres/*.mjs",
        "require": "./dist/models/postgres/*.cjs"
      },
      "./models/sqlite": {
        "types": "./dist/models/sqlite/index.d.mts",
        "import": "./dist/models/sqlite/index.mjs",
        "require": "./dist/models/sqlite/index.cjs"
      },
      "./models/sqlite/*": {
        "types": "./dist/models/sqlite/*.d.mts",
        "import": "./dist/models/sqlite/*.mjs",
        "require": "./dist/models/sqlite/*.cjs"
      },
      "./sql-schemas": {
        "types": "./dist/sql-schemas/index.d.mts",
        "import": "./dist/sql-schemas/index.mjs",
        "require": "./dist/sql-schemas/index.cjs"
      },
      "./sql-schemas/postgres": {
        "types": "./dist/sql-schemas/postgres/index.d.mts",
        "import": "./dist/sql-schemas/postgres/index.mjs",
        "require": "./dist/sql-schemas/postgres/index.cjs"
      },
      "./sql-schemas/postgres/*": {
        "types": "./dist/sql-schemas/postgres/*.d.mts",
        "import": "./dist/sql-schemas/postgres/*.mjs",
        "require": "./dist/sql-schemas/postgres/*.cjs"
      },
      "./sql-schemas/sqlite": {
        "types": "./dist/sql-schemas/sqlite/index.d.mts",
        "import": "./dist/sql-schemas/sqlite/index.mjs",
        "require": "./dist/sql-schemas/sqlite/index.cjs"
      },
      "./sql-schemas/sqlite/*": {
        "types": "./dist/sql-schemas/sqlite/*.d.mts",
        "import": "./dist/sql-schemas/sqlite/*.mjs",
        "require": "./dist/sql-schemas/sqlite/*.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "bundle": "tsdown --config ./build.config.ts",
    "dev": "node --env-file=../../.env.development --run bundle",
    "build": "node --env-file=../../.env.production --run bundle",
    "format": "prettier \"./**/*.{js,ts,jsx,tsx,md,json,jsonc}\" --write",
    "lint": "TIMING=1 eslint \"./**/*.{js,jsx,ts,tsx,md,json,jsonc}\" --fix",
    "clean": "run-p \"clean:**\"",
    "clean:cache": "rimraf dist",
    "clean:deps": "rimraf node_modules"
  },
  "dependencies": {
    "@shamt/app-env": "workspace:*",
    "drizzle-orm": "catalog:drizzle",
    "drizzle-zod": "catalog:drizzle",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@unconfig/ts-config": "catalog:dx",
    "drizzle-kit": "catalog:drizzle",
    "tsdown": "catalog:dx",
    "typescript": "catalog:"
  }
}
