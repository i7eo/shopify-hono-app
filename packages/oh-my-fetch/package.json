{
  "name": "@shamt/oh-my-fetch",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "author": "i7eo",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "require": "./src/client/index.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "import": "./src/errors/index.ts",
      "require": "./src/errors/index.ts"
    },
    "./status": {
      "types": "./src/status/index.ts",
      "import": "./src/status/index.ts",
      "require": "./src/status/index.ts"
    },
    "./validation": {
      "types": "./src/validation/index.ts",
      "import": "./src/validation/index.ts",
      "require": "./src/validation/index.ts"
    },
    "./json": {
      "types": "./src/security/json.ts",
      "import": "./src/security/json.ts",
      "require": "./src/security/json.ts"
    },
    "./dedupe": {
      "types": "./src/lifecycle/dedupe.ts",
      "import": "./src/lifecycle/dedupe.ts",
      "require": "./src/lifecycle/dedupe.ts"
    },
    "./plugins/business-status": {
      "types": "./src/plugins/business-status.ts",
      "import": "./src/plugins/business-status.ts",
      "require": "./src/plugins/business-status.ts"
    },
    "./plugins/error-reporter": {
      "types": "./src/plugins/error-reporter.ts",
      "import": "./src/plugins/error-reporter.ts",
      "require": "./src/plugins/error-reporter.ts"
    },
    "./plugins/request-format": {
      "types": "./src/plugins/request-format.ts",
      "import": "./src/plugins/request-format.ts",
      "require": "./src/plugins/request-format.ts"
    },
    "./plugins/validation": {
      "types": "./src/plugins/validation.ts",
      "import": "./src/plugins/validation.ts",
      "require": "./src/plugins/validation.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "require": "./src/utils/index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/esm/index.d.mts",
        "import": "./dist/esm/index.mjs",
        "require": "./dist/cjs/index.cjs"
      },
      "./client": {
        "types": "./dist/esm/client/index.d.mts",
        "import": "./dist/esm/client/index.mjs",
        "require": "./dist/cjs/client/index.cjs"
      },
      "./errors": {
        "types": "./dist/esm/errors/index.d.mts",
        "import": "./dist/esm/errors/index.mjs",
        "require": "./dist/cjs/errors/index.cjs"
      },
      "./status": {
        "types": "./dist/esm/status/index.d.mts",
        "import": "./dist/esm/status/index.mjs",
        "require": "./dist/cjs/status/index.cjs"
      },
      "./validation": {
        "types": "./dist/esm/validation/index.d.mts",
        "import": "./dist/esm/validation/index.mjs",
        "require": "./dist/cjs/validation/index.cjs"
      },
      "./json": {
        "types": "./dist/esm/security/json.d.mts",
        "import": "./dist/esm/security/json.mjs",
        "require": "./dist/cjs/security/json.cjs"
      },
      "./dedupe": {
        "types": "./dist/esm/lifecycle/dedupe.d.mts",
        "import": "./dist/esm/lifecycle/dedupe.mjs",
        "require": "./dist/cjs/lifecycle/dedupe.cjs"
      },
      "./plugins/business-status": {
        "types": "./dist/esm/plugins/business-status.d.mts",
        "import": "./dist/esm/plugins/business-status.mjs",
        "require": "./dist/cjs/plugins/business-status.cjs"
      },
      "./plugins/error-reporter": {
        "types": "./dist/esm/plugins/error-reporter.d.mts",
        "import": "./dist/esm/plugins/error-reporter.mjs",
        "require": "./dist/cjs/plugins/error-reporter.cjs"
      },
      "./plugins/request-format": {
        "types": "./dist/esm/plugins/request-format.d.mts",
        "import": "./dist/esm/plugins/request-format.mjs",
        "require": "./dist/cjs/plugins/request-format.cjs"
      },
      "./plugins/validation": {
        "types": "./dist/esm/plugins/validation.d.mts",
        "import": "./dist/esm/plugins/validation.mjs",
        "require": "./dist/cjs/plugins/validation.cjs"
      },
      "./utils": {
        "types": "./dist/esm/utils/index.d.mts",
        "import": "./dist/esm/utils/index.mjs",
        "require": "./dist/cjs/utils/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "pnpm clean:cache && node --env-file=../../.env.development ./node_modules/rolldown/bin/cli.mjs --config ./build.config.ts",
    "build": "pnpm clean:cache && node --env-file=../../.env.production ./node_modules/rolldown/bin/cli.mjs --config ./build.config.ts",
    "test": "node --env-file=../../.env.development ./node_modules/vitest/vitest.mjs run",
    "format": "prettier \"./**/*.{js,ts,jsx,tsx,md,json,jsonc}\" --write",
    "lint": "TIMING=1 eslint \"./**/*.{js,jsx,ts,tsx,md,json,jsonc}\" --fix",
    "clean": "run-p \"clean:**\"",
    "clean:cache": "rimraf dist",
    "clean:deps": "rimraf node_modules"
  },
  "dependencies": {
    "@shamt/envs": "workspace:*",
    "@unimolecule/utils": "catalog:",
    "ky": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@unconfig/ts-config": "catalog:dx",
    "rolldown": "catalog:dx",
    "rolldown-plugin-dts": "catalog:dx",
    "typescript": "catalog:",
    "vitest": "catalog:test"
  }
}
