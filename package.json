{
  "name": "@shamt/repository",
  "type": "module",
  "private": true,
  "description": "🚀 A modern high-performance monorepo project with hono + shopify app!",
  "author": "i7eo",
  "license": "MIT",
  "keywords": [
    "hono",
    "monorepo",
    "shopify",
    "shopify app"
  ],
  "scripts": {
    "postinstall": "simple-git-hooks",
    "dev:tunnel": "TUNNEL_TRANSPORT_PROTOCOL=http2 wrangler tunnel run sofary",
    "dev:prepare": "node --env-file=./.env.development --import tsx ./scripts/write-shopify-file/index.ts",
    "app:dev": "pnpm dev:prepare && shopify app dev --tunnel-url=https://sofary-app-dev-server.i7eo.com:10101",
    "deploy:prepare": "node --env-file=./.env.production --import tsx ./scripts/write-shopify-file/index.ts",
    "app:deploy": "pnpm deploy:prepare && shopify app deploy",
    "dev": "pnpm app:dev",
    "format": "pnpm -F \"*\" format",
    "lint": "pnpm -F \"*\" lint",
    "clean": "run-s \"clean:**\"",
    "clean:workspace": "pnpm -F \"*\" clean",
    "clean:cache": "rimraf pnpm-lock.yaml && rimraf node_modules",
    "commit": "czg",
    "upgrade:pkgs": "pnpm update -r --interactive --latest"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:dx",
    "@commitlint/config-conventional": "catalog:dx",
    "@commitlint/types": "catalog:dx",
    "@manypkg/get-packages": "catalog:dx",
    "@shamt/app-env": "workspace:*",
    "@shopify/cli": "catalog:shopify",
    "@sxzz/eslint-config": "catalog:dx",
    "@types/node": "catalog:",
    "@unconfig/stylelint-config": "catalog:dx",
    "@unconfig/ts-config-latest": "catalog:dx",
    "czg": "catalog:dx",
    "eslint": "catalog:dx",
    "lint-staged": "catalog:dx",
    "npm-run-all2": "catalog:",
    "prettier": "catalog:dx",
    "prettier-plugin-tailwindcss": "catalog:dx",
    "rimraf": "catalog:",
    "simple-git-hooks": "catalog:dx",
    "tsx": "catalog:dx",
    "typescript": "catalog:",
    "wrangler": "catalog:cloudflare"
  },
  "simple-git-hooks": {
    "pre-commit": "lint-staged --concurrent false",
    "commit-msg": "commitlint --edit $1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0",
      "onFail": "download"
    }
  }
}
